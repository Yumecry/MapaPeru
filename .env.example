# Copiar a .env.local (desarrollo) y configurar las mismas variables en Vercel.
# Nunca poner valores reales en este archivo. Ver README.md > "Variables de entorno".

# NASA FIRMS (MAP_KEY) - registro gratuito en https://firms.modaps.eosdis.nasa.gov/api/
# Solo servidor: la usa /api/cron/firms-sync para descargar los focos.
NASA_FIRMS_API_KEY=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Anon key pública: solo para la sesión de los verificadores (/login, /verify, proxy).
# No accede a tablas: tras las migraciones anon/authenticated no tienen permisos.
# Desactivar el sign-up público en Supabase Auth (ver README.md > "Despliegue").
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: SOLO servidor, nunca con prefijo NEXT_PUBLIC_ (salta RLS).
# Debe configurarse ANTES de aplicar la migración 002_lock_down.sql, o la app deja de funcionar.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: alternativa a NEXT_PUBLIC_SUPABASE_URL para el cliente service_role.
# SUPABASE_URL=

# WhatsApp del equipo de respuesta, formato internacional solo dígitos (9-15), p. ej. 51987654321.
# Los solicitantes reciben un enlace wa.me hacia este número para pedir verificación.
RESPONSE_TEAM_WHATSAPP=

# Secreto del sync de focos (/api/cron/firms-sync). OBLIGATORIO: sin él la ruta responde 500.
# Se envía como "Authorization: Bearer <CRON_SECRET>". Usar un valor largo y aleatorio
# (p. ej. `openssl rand -hex 32`) y guardar el MISMO valor en Supabase Vault como 'cron_secret'
# antes de aplicar supabase/migrations/006_schedule_firms_sync.sql.
CRON_SECRET=
