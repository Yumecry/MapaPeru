# NASA FIRMS - requiere registro en https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# La anon key pública NO se usa en el servidor; se mantiene para el login (Fase 4).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: SOLO servidor, nunca con prefijo NEXT_PUBLIC_.
# Debe configurarse ANTES de aplicar la migración 002_lock_down.sql, o la app deja de funcionar.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: alternativa a NEXT_PUBLIC_SUPABASE_URL para el servidor.
# SUPABASE_URL=

# WhatsApp del equipo de respuesta, formato internacional solo dígitos (9-15), p. ej. 51987654321.
# Los solicitantes reciben un enlace wa.me hacia este número para pedir verificación.
RESPONSE_TEAM_WHATSAPP=

# Secret compartido para jobs programados (opcional)
CRON_SECRET=
